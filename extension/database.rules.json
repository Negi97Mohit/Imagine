{
  "rules": {
    "bindings": {
      ".read": true,
      "$assetId": {
        ".write": true,
        "$pushId": {
          ".validate": "newData.hasChildren(['interaction', 'createdBy', 'updatedAt']) && newData.child('interaction').hasChildren(['name', 'js']) && newData.child('createdBy').isString() && newData.child('updatedAt').isString()"
        }
      }
    },
    "interactions": {
      ".read": true,
      "$interactionId": {
        ".write": true,
        ".validate": "newData.hasChildren(['name', 'js', 'createdAt']) && newData.child('name').isString() && newData.child('js').isString()"
      }
    },
    "redesigns": {
      ".read": true,
      "$domain": {
        ".write": true,
        "$pushId": {
          ".validate": "newData.hasChildren(['selector', 'visibility', 'createdBy', 'createdAt']) && newData.child('selector').isString() && newData.child('visibility').isString() && newData.child('createdBy').isString() && newData.child('createdAt').isString()"
        }
      }
    },
    "redesign_presets": {
      ".read": true,
      "$presetId": {
        ".write": true,
        ".validate": "newData.hasChildren(['name', 'createdBy', 'createdAt']) && newData.child('name').isString() && newData.child('createdBy').isString() && newData.child('createdAt').isString()"
      }
    }
  }
}
